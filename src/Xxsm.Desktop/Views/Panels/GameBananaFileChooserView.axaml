<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Xxsm.Desktop.ViewModels"
             x:Class="Xxsm.Desktop.Views.Panels.GameBananaFileChooserView"
             x:DataType="vm:GameBananaFileChooserViewModel">

  <!-- Which of a page's files, before anything downloads. The author's name for each file leads. -->
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
               Foreground="{DynamicResource XxsmTextBrush}"
               Text="{Binding PromptText}" />

    <ListBox Classes="fileChoices"
             ItemsSource="{Binding Files}"
             SelectedItem="{Binding Selected}"
             AutomationProperties.Name="{Binding PromptText}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:GameBananaFileChoiceViewModel">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="{DynamicResource XxsmTextBrush}"
                         Text="{Binding Title}" />
              <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top"
                      IsVisible="{Binding IsInstalled}">
                <TextBlock Text="{DynamicResource Text.GameBananaFiles_Installed}" />
              </Border>
            </Grid>
            <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding HasFileName}"
                       ToolTip.Tip="{Binding FileName}"
                       Text="{Binding FileName}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding DetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding DetailText}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>

</UserControl>
