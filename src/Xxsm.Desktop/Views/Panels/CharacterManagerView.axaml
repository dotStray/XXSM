<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Xxsm.Desktop.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:panels="clr-namespace:Xxsm.Desktop.Views.Panels"
             x:Class="Xxsm.Desktop.Views.Panels.CharacterManagerView"
             x:Name="Root"
             x:DataType="vm:CharacterManagerViewModel">

  <!-- The Character Manager, over the page you are on; the editor, the delete question and the mod picker replace each
       other. -->
  <Panel>

      <!-- Learn from a mod…: every mod as a tile, in the editor's place. -->
      <Border Classes="card" Margin="24" MaxWidth="1180"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              IsVisible="{Binding IsPicking}">
        <panels:ModPickerView DataContext="{Binding Picker}" />
      </Border>

      <!-- The Character Manager, over the grid rather than in a dialog. -->
      <Border Classes="card" MaxWidth="560" MaxHeight="720"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsVisible="{Binding IsEditorShowing}">
        <DockPanel DataContext="{Binding Editor}" x:DataType="vm:CharacterEditorViewModel">

          <TextBlock DockPanel.Dock="Top" Classes="subheading" Margin="0,0,0,12"
                     Text="{Binding Heading}" />

          <!-- The buttons dock to the bottom so the expander can never push Create off the panel. -->
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,14,0,0">
            <Button Classes="destructive" Grid.Column="0"
                    IsVisible="{Binding CanDelete}"
                    Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).StartDeleteCommand}"
                    Content="{DynamicResource Text.CharacterEditor_Delete}" />
            <Button Grid.Column="1" Margin="8,0,0,0"
                    IsVisible="{Binding CanReset}"
                    Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).ResetCharacterCommand}"
                    Content="{DynamicResource Text.CharacterEditor_Reset}" />
            <Button Grid.Column="3"
                    Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).CancelEditCommand}"
                    Content="{DynamicResource Text.CharacterEditor_Cancel}" />
            <Button Grid.Column="4" Classes="accent" Margin="8,0,0,0"
                    IsEnabled="{Binding CanSave}"
                    Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).SaveEditCommand}"
                    Content="{Binding SaveText}" />
          </Grid>

          <ScrollViewer>
            <StackPanel Spacing="12">

              <!-- The whole required path: one box and a button. -->
              <StackPanel Spacing="4">
                <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.CharacterEditor_Name}" />
                <TextBox x:Name="NameBox" Text="{Binding Name}"
                         PlaceholderText="{DynamicResource Text.CharacterEditor_Name_Placeholder}"
                         AutomationProperties.Name="{DynamicResource Text.CharacterEditor_Name}" />
                <TextBlock Classes="muted" FontSize="11"
                           IsVisible="{Binding HasFolderText}"
                           Text="{Binding FolderText}" />
              </StackPanel>

              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding Notice, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                         Text="{Binding Notice}" />

              <!-- Everything else, closed to start with. -->
              <Expander IsExpanded="{Binding IsExpanded}"
                        Header="{DynamicResource Text.CharacterEditor_More}">
                <StackPanel Spacing="12" Margin="0,8,0,0">

                  <StackPanel Spacing="4">
                    <TextBlock Classes="sectionLabel"
                               Text="{DynamicResource Text.CharacterEditor_InternalName}" />
                    <TextBox x:Name="InternalNameBox" Text="{Binding InternalName}"
                             PlaceholderText="{Binding EffectiveInternalName}"
                             AutomationProperties.Name="{DynamicResource Text.CharacterEditor_InternalName}" />
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="{DynamicResource Text.CharacterEditor_InternalName_Hint}" />
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Classes="sectionLabel"
                               Text="{DynamicResource Text.CharacterEditor_ModFilesName}" />
                    <TextBox x:Name="ModFilesNameBox" Text="{Binding ModFilesName}"
                             PlaceholderText="{Binding EffectiveInternalName}"
                             AutomationProperties.Name="{DynamicResource Text.CharacterEditor_ModFilesName}" />
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Classes="sectionLabel"
                               Text="{DynamicResource Text.CharacterEditor_Aliases}" />
                    <TextBox Text="{Binding Aliases}"
                             PlaceholderText="{DynamicResource Text.CharacterEditor_Aliases_Placeholder}"
                             AutomationProperties.Name="{DynamicResource Text.CharacterEditor_Aliases}" />
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Classes="sectionLabel"
                               Text="{DynamicResource Text.CharacterEditor_BaseCharacter}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                ItemsSource="{Binding BaseCharacterChoices}"
                                SelectedItem="{Binding SelectedBaseCharacter}"
                                PlaceholderText="{DynamicResource Text.CharacterEditor_BaseCharacter_None}"
                                AutomationProperties.Name="{DynamicResource Text.CharacterEditor_BaseCharacter}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:CharacterChoiceViewModel">
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1" Margin="8,0,0,0"
                              Command="{Binding ClearBaseCharacterCommand}"
                              Content="{DynamicResource Text.CharacterEditor_Detach}" />
                    </Grid>
                  </StackPanel>

                  <!-- The portrait: a drop, Ctrl+V, Paste or Choose; copied into XXSM's data on save. -->
                  <StackPanel Spacing="4">
                    <TextBlock Classes="sectionLabel"
                               Text="{DynamicResource Text.CharacterEditor_Portrait}" />
                    <Grid ColumnDefinitions="Auto,*">
                      <Border x:Name="PortraitArea" Grid.Column="0" Classes="editorPortrait imageTarget"
                              Focusable="True" DragDrop.AllowDrop="True"
                              AutomationProperties.Name="{DynamicResource Text.CharacterEditor_Portrait_Area}">
                        <Border.KeyBindings>
                          <KeyBinding Gesture="Ctrl+V"
                                      Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).PastePortraitCommand}" />
                        </Border.KeyBindings>
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{DynamicResource Text.CharacterEditor_Portrait_Choose}"
                                      Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).ChoosePortraitCommand}" />
                            <MenuItem Header="{DynamicResource Text.CharacterEditor_Portrait_Paste}"
                                      Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).PastePortraitCommand}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Panel>
                          <TextBlock Classes="muted" FontSize="11" Margin="10,0"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     TextWrapping="Wrap" TextAlignment="Center"
                                     IsVisible="{Binding !HasPortrait}"
                                     Text="{DynamicResource Text.CharacterEditor_Portrait_Drop}" />
                          <Image Source="{Binding Portrait}"
                                 IsVisible="{Binding HasPortrait}"
                                 Stretch="UniformToFill" />
                        </Panel>
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button HorizontalAlignment="Left"
                                Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).ChoosePortraitCommand}"
                                Content="{DynamicResource Text.CharacterEditor_Portrait_Choose}" />
                        <Button HorizontalAlignment="Left"
                                IsVisible="{Binding CanRemovePortrait}"
                                Command="{Binding ClearImageCommand}"
                                Content="{DynamicResource Text.CharacterEditor_Portrait_Clear}" />
                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource XxsmWarnBrush}"
                                   IsVisible="{Binding PortraitError, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                   Text="{Binding PortraitError}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>

                  <!-- Hashes: the list, a box that parses whatever is pasted, and Learn from a mod. -->
                  <StackPanel Spacing="6">
                    <!-- The arrow opens the whole list in one box, the editor Studio's table opens. -->
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="sectionLabel" VerticalAlignment="Center"
                                 Text="{DynamicResource Text.CharacterEditor_Hashes}" />
                      <Button Grid.Column="1" Classes="iconButton"
                              Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).OpenHashListCommand}"
                              ToolTip.Tip="{DynamicResource Text.CharacterEditor_Hashes_Open}"
                              AutomationProperties.Name="{DynamicResource Text.CharacterEditor_Hashes_Open}">
                        <Path Data="{StaticResource Icon.open}" />
                      </Button>
                    </Grid>
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="{Binding HashesText}" />

                    <!-- A box of its own, about eight rows tall: a long list keeps the rest of the panel in reach.
                         Only the rows on screen are built. -->
                    <ScrollViewer MaxHeight="320" IsVisible="{Binding HasHashes}">
                    <ItemsControl ItemsSource="{Binding Hashes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HashRowViewModel">
                          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                            <TextBlock Grid.Column="0" Classes="mono" FontSize="12"
                                       VerticalAlignment="Center" Text="{Binding Hash}" />
                            <TextBlock Grid.Column="1" Classes="muted" FontSize="11" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Text="{Binding KindText}" />
                            <Button Grid.Column="2" Classes="iconButton destructive"
                                    Command="{Binding $parent[ItemsControl].((vm:CharacterEditorViewModel)DataContext).RemoveHashCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{DynamicResource Text.CharacterEditor_Hashes_Remove}"
                                    AutomationProperties.Name="{DynamicResource Text.CharacterEditor_Hashes_Remove}">
                              <Path Data="{StaticResource Icon.delete}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <TextBox AcceptsReturn="True" Height="76"
                             Text="{Binding PastedHashes}"
                             PlaceholderText="{DynamicResource Text.CharacterEditor_Paste_Placeholder}"
                             AutomationProperties.Name="{DynamicResource Text.CharacterEditor_Paste}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Command="{Binding ReadHashPasteCommand}"
                              Content="{DynamicResource Text.CharacterEditor_Paste_Read}" />
                      <Button Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).LearnFromModCommand}"
                              Content="{DynamicResource Text.CharacterEditor_Learn}" />
                    </StackPanel>

                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding HashPasteSummary, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                               Text="{Binding HashPasteSummary}" />
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.CharacterEditor_Notes}" />
                    <TextBox AcceptsReturn="True" Height="60" Text="{Binding Notes}"
                             AutomationProperties.Name="{DynamicResource Text.CharacterEditor_Notes}" />
                  </StackPanel>

                  <CheckBox IsChecked="{Binding Hidden}"
                            Content="{DynamicResource Text.CharacterEditor_Hidden}" />

                  <StackPanel Spacing="6" IsVisible="{Binding CanUnlock}">
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="{DynamicResource Text.CharacterEditor_Locked_Note}" />
                    <Button HorizontalAlignment="Left"
                            Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).UnlockCharacterCommand}"
                            Content="{DynamicResource Text.CharacterEditor_Unlock}" />
                  </StackPanel>

                </StackPanel>
              </Expander>

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Deleting a custom character asks first where its mods go: XXSM never deletes a folder with mods in it. -->
      <Border Classes="card" MaxWidth="440" MaxHeight="520"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsVisible="{Binding IsDeleting}">
        <DockPanel DataContext="{Binding Deleting}" x:DataType="vm:CharacterDeleteViewModel">

          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Classes="subheading" Text="{Binding Heading}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Body}" />
          </StackPanel>

          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="1"
                    Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).CancelDeleteCommand}"
                    Content="{DynamicResource Text.CharacterEditor_Cancel}" />
            <Button Grid.Column="2" Classes="destructive" Margin="8,0,0,0"
                    IsEnabled="{Binding CanConfirm}"
                    Command="{Binding #Root.((vm:CharacterManagerViewModel)DataContext).ConfirmDeleteCommand}"
                    Content="{DynamicResource Text.CharacterDelete_Confirm}" />
          </Grid>

          <StackPanel Spacing="8" IsVisible="{Binding HasMods}">
            <RadioButton GroupName="rehome" IsChecked="{Binding !ToCharacter}"
                         Content="{DynamicResource Text.CharacterDelete_ToOthers}" />
            <RadioButton GroupName="rehome" IsChecked="{Binding ToCharacter}"
                         Content="{DynamicResource Text.CharacterDelete_ToCharacter}" />

            <StackPanel Spacing="6" Margin="22,0,0,0" IsVisible="{Binding ToCharacter}">
              <TextBox Classes="toolbarSearch" Text="{Binding SearchText}"
                       PlaceholderText="{DynamicResource Text.CharacterDelete_SearchPlaceholder}"
                       AutomationProperties.Name="{DynamicResource Text.CharacterDelete_SearchPlaceholder}" />
              <ScrollViewer MaxHeight="180">
                <ItemsControl ItemsSource="{Binding Targets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CharacterChoiceViewModel">
                      <Button Classes="moveTarget"
                              Command="{Binding $parent[ItemsControl].((vm:CharacterDeleteViewModel)DataContext).ChooseCommand}"
                              CommandParameter="{Binding}"
                              Content="{Binding DisplayName}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

    <!-- The whole hash list in one box, over the editor. -->
    <panels:HashListEditorView DataContext="{Binding HashList}" />

  </Panel>

</UserControl>
