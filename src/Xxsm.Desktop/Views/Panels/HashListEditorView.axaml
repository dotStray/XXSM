<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Xxsm.Desktop.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="Xxsm.Desktop.Views.Panels.HashListEditorView"
             x:DataType="vm:HashListEditorViewModel"
             x:Name="Root"
             IsVisible="{Binding IsOpen}">

  <!-- One character's hashes as text, from Studio's table and the Character Manager alike. -->
  <Panel>
    <Border Classes="scrim" />

    <Border Classes="card" Width="620"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="10">
        <TextBlock Classes="subheading" TextWrapping="Wrap" Text="{Binding Title}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="{DynamicResource Text.Studio_Hashes_Help}" />

        <!-- What the editor was opened for; Remove takes it out of the box, and nothing is written until Save. -->
        <Border Classes="fixTarget on" IsVisible="{Binding HasMarks}">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Hashes_Marked}" />
            <ScrollViewer MaxHeight="150">
              <ItemsControl ItemsSource="{Binding Marks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StudioMarkedHashViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,4">
                      <SelectableTextBlock Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="{Binding Hash}" />
                      <TextBlock Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Reason}" ToolTip.Tip="{Binding Reason}" />
                      <!-- An ignored hash is still the character's: the offer is to make it count again. -->
                      <Button Classes="destructive" Grid.Column="2" IsVisible="{Binding !IsIgnored}"
                              Command="{Binding #Root.((vm:HashListEditorViewModel)DataContext).RemoveMarkedCommand}"
                              CommandParameter="{Binding}"
                              Content="{DynamicResource Text.Studio_Hashes_Mark_Remove}" />
                      <Button Grid.Column="2"
                              Command="{Binding #Root.((vm:HashListEditorViewModel)DataContext).StopIgnoringCommand}"
                              CommandParameter="{Binding}"
                              Content="{DynamicResource Text.Studio_Sharing_StopIgnoring}">
                        <Button.IsVisible>
                          <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                            <Binding Path="IsIgnored" />
                            <Binding Path="#Root.((vm:HashListEditorViewModel)DataContext).CanStopIgnoring" />
                          </MultiBinding>
                        </Button.IsVisible>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <TextBox x:Name="HashesBox" AcceptsReturn="True" TextWrapping="NoWrap"
                 Height="320" FontFamily="monospace"
                 Text="{Binding HashesText}"
                 PlaceholderText="{DynamicResource Text.CharacterEditor_Paste_Placeholder}"
                 AutomationProperties.Name="{Binding Title}" />

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="muted" FontSize="12" VerticalAlignment="Center"
                     Text="{Binding Preview}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding CancelCommand}"
                    Content="{DynamicResource Text.Studio_Hashes_Cancel}" />
            <Button Classes="accent"
                    Command="{Binding SaveCommand}"
                    Content="{DynamicResource Text.Studio_Hashes_Save}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
