<UserControl xmlns="https://github.com/avaloniaui"
             x:Name="Root"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:paths="clr-namespace:Xxsm.Desktop.Converters"
             xmlns:panels="clr-namespace:Xxsm.Desktop.Views.Panels"
             xmlns:firstRun="clr-namespace:Xxsm.Desktop.ViewModels.FirstRun"
             xmlns:vm="clr-namespace:Xxsm.Desktop.ViewModels"
             x:Class="Xxsm.Desktop.Views.FirstRunView"
             x:DataType="firstRun:FirstRunViewModel"
             Background="{DynamicResource XxsmPageBrush}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="40,32,40,24" MaxWidth="760">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
      <TextBlock Classes="sectionLabel" Text="{Binding StepText}" />
      <TextBlock Classes="heading" FontSize="26" Text="{Binding Heading}" />
    </StackPanel>

    <!-- Steps: one panel each, inside the same card the rest of the application uses. -->
    <ScrollViewer Grid.Row="1">
      <Border Classes="card" Padding="24" VerticalAlignment="Top">
        <Panel>

          <StackPanel Spacing="14" IsVisible="{Binding IsWelcome}" VerticalAlignment="Top">
            <TextBlock Classes="muted" Text="{DynamicResource Text.FirstRun_Welcome_Body}" />
            <!-- After a reset: what went to the Trash, and anything that could not. -->
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource XxsmOkBrush}"
                       IsVisible="{Binding ResetNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding ResetNote}" />
            <SelectableTextBlock TextWrapping="Wrap" Foreground="{DynamicResource XxsmWarnBrush}"
                                 IsVisible="{Binding ResetProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Text="{Binding ResetProblem}" />
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsPack}" VerticalAlignment="Top">
            <TextBlock Classes="muted" Text="{DynamicResource Text.FirstRun_Pack_Body}" />

            <TextBlock Classes="muted" IsVisible="{Binding IsBusy}" Text="{Binding BusyMessage}" />

            <Border Classes="card" IsVisible="{Binding IsOffline}">
              <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="{DynamicResource Text.FirstRun_Pack_Offline}" />
                <SelectableTextBlock Classes="mono" FontSize="11" Text="{Binding RegistryProblem}" />
              </StackPanel>
            </Border>

            <TextBlock Classes="muted"
                       IsVisible="{Binding !HasPacks}"
                       Text="{DynamicResource Text.FirstRun_Pack_None}" />

            <ListBox ItemsSource="{Binding Packs}"
                     SelectedItem="{Binding SelectedPack}"
                     IsVisible="{Binding HasPacks}"
                     MaxHeight="260"
                     Background="Transparent"
                     AutomationProperties.Name="{DynamicResource Text.FirstRun_Pack_Heading}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PackChoiceViewModel">
                  <StackPanel Spacing="2" Margin="0,2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <panels:GameIconView DataContext="{Binding Icon}" />
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Classes="badge">
                        <TextBlock Text="{Binding Version}" />
                      </Border>
                      <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                                 IsVisible="{Binding HasSize}" Text="{Binding SizeText}" />
                    </StackPanel>
                    <!-- Whether it is in yet, so installing a second pack is plainly the next thing. -->
                    <TextBlock FontSize="12" Classes="muted" Classes.installed="{Binding IsInstalled}"
                               Text="{Binding StatusText}" />
                    <TextBlock Classes="muted" FontSize="11"
                               IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding Summary}" />
                    <!-- While this pack installs: how far the download is, then checking and unpacking. -->
                    <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding IsInstalling}">
                      <ProgressBar Height="4" Width="280" HorizontalAlignment="Left"
                                   Minimum="0" Maximum="100"
                                   Value="{Binding ProgressPercent}"
                                   IsIndeterminate="{Binding IsProgressIndeterminate}" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource XxsmTextBrush}" Text="{Binding ProgressText}" />
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource XxsmWarnBrush}"
                               IsVisible="{Binding RefusalReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"
                               Text="{Binding RefusalReason}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Command="{Binding InstallSelectedPackCommand}"
                      Content="{DynamicResource Text.FirstRun_Pack_Install}" />
              <TextBlock Classes="muted" VerticalAlignment="Center"
                         IsVisible="{Binding HasInstalledPack}"
                         Foreground="{DynamicResource XxsmOkBrush}"
                         Text="{Binding InstalledPackSummary}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsModsFolder}" VerticalAlignment="Top">
            <TextBlock Classes="muted" Text="{DynamicResource Text.FirstRun_Mods_Body}" />

            <!-- One row per installed game, each with its own folder. -->
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding !HasGameFolders}"
                       Text="{DynamicResource Text.FirstRun_Mods_NoGames}" />

            <ItemsControl ItemsSource="{Binding GameFolders}" IsVisible="{Binding HasGameFolders}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="firstRun:FirstRunGameFolderViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <panels:GameIconView Grid.Column="0" DataContext="{Binding Icon}" Width="28" Height="28" />
                        <TextBlock Grid.Column="1" Classes="subheading" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                        <Button Grid.Column="2"
                                Command="{Binding #Root.((firstRun:FirstRunViewModel)DataContext).BrowseForModsFolderCommand}"
                                CommandParameter="{Binding}"
                                Content="{DynamicResource Text.FirstRun_Mods_Browse}"
                                AutomationProperties.Name="{Binding DisplayName}" />
                      </Grid>
                      <SelectableTextBlock Classes="mono" FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding HasModsDirectory}"
                                           Text="{Binding ModsDirectory, Converter={x:Static paths:PathConverters.Display}}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 IsVisible="{Binding HasNote}" Text="{Binding Note}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsDone}" VerticalAlignment="Top">
            <TextBlock Classes="muted" Text="{DynamicResource Text.FirstRun_Done_Body}" />

            <!-- Every game set up, and the folder each will use. -->
            <TextBlock Classes="muted" IsVisible="{Binding !HasGameFolders}"
                       Text="{DynamicResource Text.FirstRun_Done_NoGames}" />
            <Border Classes="card" IsVisible="{Binding HasGameFolders}">
              <ItemsControl ItemsSource="{Binding GameFolders}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="firstRun:FirstRunGameFolderViewModel">
                    <Grid ColumnDefinitions="Auto,170,*" ColumnSpacing="10">
                      <panels:GameIconView Grid.Column="0" DataContext="{Binding Icon}" Width="20" Height="20" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Text="{Binding DisplayName}" />
                      <SelectableTextBlock Grid.Column="2" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                           TextWrapping="Wrap" IsVisible="{Binding HasModsDirectory}"
                                           Text="{Binding ModsDirectory, Converter={x:Static paths:PathConverters.Display}}" />
                      <TextBlock Grid.Column="2" Classes="muted" FontSize="12" VerticalAlignment="Center"
                                 TextWrapping="Wrap" IsVisible="{Binding !HasModsDirectory}"
                                 Text="{DynamicResource Text.FirstRun_Done_NoFolder}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <!-- Three things a new user may want on, all off unless turned on here or in Settings. -->
            <TextBlock Classes="subheading" Margin="0,6,0,0" Text="{DynamicResource Text.FirstRun_Options_Heading}" />

            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch Classes="modSwitch" VerticalAlignment="Center"
                              IsChecked="{Binding AutoUpdatePacks}"
                              OnContent="{x:Null}" OffContent="{x:Null}"
                              AutomationProperties.Name="{DynamicResource Text.Settings_PackUpdates_Auto}" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource XxsmTextBrush}"
                           Text="{DynamicResource Text.Settings_PackUpdates_Auto}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="58,0,0,0"
                         Text="{DynamicResource Text.FirstRun_Options_AutoUpdate_Help}" />
            </StackPanel>

            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch Classes="modSwitch" VerticalAlignment="Center"
                              IsChecked="{Binding EnableGameBanana}"
                              OnContent="{x:Null}" OffContent="{x:Null}"
                              AutomationProperties.Name="{DynamicResource Text.Settings_GameBanana_Enabled}" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource XxsmTextBrush}"
                           Text="{DynamicResource Text.Settings_GameBanana_Enabled}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="58,0,0,0"
                         Text="{DynamicResource Text.FirstRun_Options_GameBanana_Help}" />
            </StackPanel>

            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch Classes="modSwitch" VerticalAlignment="Center"
                              IsChecked="{Binding ShowPackStudio}"
                              OnContent="{x:Null}" OffContent="{x:Null}"
                              AutomationProperties.Name="{DynamicResource Text.Settings_Studio_Show}" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource XxsmTextBrush}"
                           Text="{DynamicResource Text.Settings_Studio_Show}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="58,0,0,0"
                         Text="{DynamicResource Text.FirstRun_Options_Studio_Help}" />
            </StackPanel>
          </StackPanel>

        </Panel>
      </Border>
    </ScrollViewer>

    <!-- Footer. Skip is always available: setup is never mandatory. -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,20,0,0">

      <Button Grid.Column="0"
              Command="{Binding SkipCommand}"
              Content="{DynamicResource Text.FirstRun_Skip}" />

      <Button Grid.Column="2" Margin="0,0,10,0"
              Command="{Binding BackCommand}"
              IsEnabled="{Binding CanGoBack}"
              Content="{DynamicResource Text.FirstRun_Back}" />

      <Button Grid.Column="3"
              Command="{Binding NextCommand}"
              IsVisible="{Binding CanGoNext}"
              Classes="accent"
              Content="{DynamicResource Text.FirstRun_Next}" />

      <Button Grid.Column="4"
              Command="{Binding FinishCommand}"
              IsVisible="{Binding IsDone}"
              Classes="accent"
              Content="{DynamicResource Text.FirstRun_Finish}" />

    </Grid>

  </Grid>

</UserControl>
