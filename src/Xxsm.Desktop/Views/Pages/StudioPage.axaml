<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:paths="clr-namespace:Xxsm.Desktop.Converters"
             xmlns:vm="clr-namespace:Xxsm.Desktop.ViewModels"
             xmlns:pages="clr-namespace:Xxsm.Desktop.ViewModels.Pages"
             xmlns:panels="clr-namespace:Xxsm.Desktop.Views.Panels"
             xmlns:controls="clr-namespace:Xxsm.Desktop.Controls"
             x:Class="Xxsm.Desktop.Views.Pages.StudioPage"
             x:Name="Page"
             x:DataType="pages:StudioPageViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
  </UserControl.KeyBindings>

  <Panel>

  <DockPanel Classes="page">

    <!-- The list's header. -->
    <Grid Classes="pageHeader" ColumnDefinitions="*,Auto" IsVisible="{Binding IsListShowing}">
      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock Classes="heading" Text="{DynamicResource Text.Studio_Heading}" />
        <TextBlock Classes="pageSubtitle" Text="{DynamicResource Text.Studio_Intro}" />
      </StackPanel>

      <Button Grid.Column="1" Classes="accent" VerticalAlignment="Top" Margin="16,0,0,0"
              Command="{Binding OpenNewGameCommand}"
              Content="{DynamicResource Text.Studio_NewGame}" />
    </Grid>

    <!-- An open draft's header: the way back, its name, whether it is saved, Undo and Redo. -->
    <Grid Classes="pageHeader" ColumnDefinitions="Auto,*" IsVisible="{Binding IsDraftOpen}">
      <!-- Top, not centre: the header grows a line when the buttons wrap. -->
      <Button Grid.Column="0" Classes="iconButton" VerticalAlignment="Top"
              Command="{Binding BackToDraftsCommand}"
              ToolTip.Tip="{DynamicResource Text.Studio_Back}"
              AutomationProperties.Name="{DynamicResource Text.Studio_Back}">
        <Path Data="{StaticResource Icon.back}" />
      </Button>

      <!-- The name at one end and the buttons at the other, the buttons on their own line when too narrow. -->
      <controls:SplitRow Grid.Column="1" Gap="16" LineSpacing="10">

      <StackPanel Spacing="3" Margin="10,0,0,0">
        <!-- The game's settings sit on its name, the one thing they are about. -->
        <StackPanel Orientation="Horizontal" Spacing="10">
          <panels:GameIconView DataContext="{Binding DraftIcon}" Width="30" Height="30" />
          <TextBlock Classes="heading" Text="{Binding DraftTitle}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <Button Classes="iconButton small" VerticalAlignment="Center"
                  Command="{Binding GameSettings.OpenCommand}"
                  ToolTip.Tip="{DynamicResource Text.Studio_Settings}"
                  AutomationProperties.Name="{DynamicResource Text.Studio_Settings}">
            <Path Data="{StaticResource Icon.settings}" />
          </Button>
        </StackPanel>
        <!-- Undo and Redo beside whether it is saved: both are about the edits so far. -->
        <StackPanel Orientation="Horizontal" Spacing="2"
                    IsVisible="{Binding !Session.HasFailed, FallbackValue=False}">
          <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                     Text="{Binding Session.StatusText, FallbackValue=''}" />
          <Button Classes="iconButton small"
                  Command="{Binding UndoCommand}"
                  IsEnabled="{Binding Session.CanUndo, FallbackValue=False}"
                  ToolTip.Tip="{DynamicResource Text.Studio_Undo}"
                  AutomationProperties.Name="{DynamicResource Text.Studio_Undo}">
            <Path Data="{StaticResource Icon.undo}" />
          </Button>
          <Button Classes="iconButton small"
                  Command="{Binding RedoCommand}"
                  IsEnabled="{Binding Session.CanRedo, FallbackValue=False}"
                  ToolTip.Tip="{DynamicResource Text.Studio_Redo}"
                  AutomationProperties.Name="{DynamicResource Text.Studio_Redo}">
            <Path Data="{StaticResource Icon.redo}" />
          </Button>
        </StackPanel>
        <TextBlock FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource XxsmErrorBrush}"
                   IsVisible="{Binding Session.HasFailed, FallbackValue=False}"
                   Text="{Binding Session.StatusText, FallbackValue=''}" />
      </StackPanel>

      <!-- At the foot of the header when it shares the name's line, level with Undo and Redo. -->
      <WrapPanel Classes="buttonRow" VerticalAlignment="Bottom" Margin="0,0,-8,-6">
        <!-- Bound through #Page: a flyout's items live in their own popup. -->
        <Button Content="{DynamicResource Text.Studio_Import}">
          <Button.Flyout>
            <!-- Each way in says in a line what it is for. -->
            <MenuFlyout>
              <MenuItem Command="{Binding #Page.((pages:StudioPageViewModel)DataContext).ImportAssetsCommand}"
                        AutomationProperties.Name="{DynamicResource Text.Studio_Import_Menu_Assets}">
                <MenuItem.Header>
                  <StackPanel Spacing="1" MaxWidth="340">
                    <TextBlock Text="{DynamicResource Text.Studio_Import_Menu_Assets}" />
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="{DynamicResource Text.Studio_Import_Menu_Assets_About}" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Command="{Binding #Page.((pages:StudioPageViewModel)DataContext).ImportModsFolderCommand}"
                        AutomationProperties.Name="{DynamicResource Text.Studio_Import_Menu_Mods}">
                <MenuItem.Header>
                  <StackPanel Spacing="1" MaxWidth="340">
                    <TextBlock Text="{DynamicResource Text.Studio_Import_Menu_Mods}" />
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="{DynamicResource Text.Studio_Import_Menu_Mods_About}" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Command="{Binding #Page.((pages:StudioPageViewModel)DataContext).ImportPicturesCommand}"
                        AutomationProperties.Name="{DynamicResource Text.Studio_Import_Menu_Pictures}">
                <MenuItem.Header>
                  <StackPanel Spacing="1" MaxWidth="340">
                    <TextBlock Text="{DynamicResource Text.Studio_Import_Menu_Pictures}" />
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="{DynamicResource Text.Studio_Import_Menu_Pictures_About}" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Command="{Binding #Page.((pages:StudioPageViewModel)DataContext).ImportSpreadsheetCommand}"
                        AutomationProperties.Name="{DynamicResource Text.Studio_Import_Menu_Sheet}">
                <MenuItem.Header>
                  <StackPanel Spacing="1" MaxWidth="340">
                    <TextBlock Text="{DynamicResource Text.Studio_Import_Menu_Sheet}" />
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="{DynamicResource Text.Studio_Import_Menu_Sheet_About}" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <Separator />
              <MenuItem Command="{Binding #Page.((pages:StudioPageViewModel)DataContext).ImportCorrectionsCommand}"
                        AutomationProperties.Name="{DynamicResource Text.Studio_Import_Menu_Corrections}">
                <MenuItem.Header>
                  <StackPanel Spacing="1" MaxWidth="340">
                    <TextBlock Text="{DynamicResource Text.Studio_Import_Menu_Corrections}" />
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="{DynamicResource Text.Studio_Import_Menu_Corrections_About}" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Command="{Binding OpenTryCommand}"
                Content="{DynamicResource Text.Studio_Try}" />
        <!-- Exports and installs in one step, for testing your own pack; Export is for handing the file on. -->
        <Button IsEnabled="{Binding CanInstallHere}"
                Command="{Binding InstallHereCommand}"
                Content="{DynamicResource Text.Studio_Install}" />
        <Button Classes="accent"
                Command="{Binding OpenExportCommand}"
                Content="{DynamicResource Text.Studio_Export}" />
      </WrapPanel>

      </controls:SplitRow>
    </Grid>

    <Panel>

      <!-- ===== The list of drafts ===== -->
      <ScrollViewer Classes="besideMargin" IsVisible="{Binding IsListShowing}">
        <StackPanel Spacing="12" Margin="0,0,0,16">

          <Border Classes="card notice" IsVisible="{Binding IsListEmpty}">
            <StackPanel Spacing="8">
              <TextBlock Classes="subheading" Text="{DynamicResource Text.Studio_Empty_Heading}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource Text.Studio_Empty_Body}" />
            </StackPanel>
          </Border>

          <TextBlock Classes="sectionLabel" IsVisible="{Binding HasDrafts}"
                     Text="{DynamicResource Text.Studio_Drafts_Heading}" />

          <ItemsControl ItemsSource="{Binding Drafts}" IsVisible="{Binding HasDrafts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:StudioDraftChoiceViewModel">
                <Border Classes="card" Margin="0,0,0,12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <panels:GameIconView DataContext="{Binding Icon}" />
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource XxsmTextBrush}" />
                      </StackPanel>
                      <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding CanOpen}"
                                 Text="{Binding SummaryText}" />
                      <StackPanel Spacing="2" IsVisible="{Binding !CanOpen}">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource XxsmErrorBrush}"
                                   Text="{DynamicResource Text.Studio_Draft_Unreadable}" />
                        <SelectableTextBlock Classes="mono" FontSize="11" TextWrapping="Wrap"
                                             Text="{Binding Error}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Top" Margin="16,0,0,0">
                      <Button Classes="destructive" Command="{Binding $parent[ItemsControl].((pages:StudioPageViewModel)DataContext).AskToDeleteDraftCommand}"
                              CommandParameter="{Binding}"
                              Content="{DynamicResource Text.Studio_Draft_Delete}" />
                      <Button Classes="accent"
                              IsVisible="{Binding CanOpen}"
                              Command="{Binding $parent[ItemsControl].((pages:StudioPageViewModel)DataContext).OpenDraftCommand}"
                              CommandParameter="{Binding}"
                              Content="{DynamicResource Text.Studio_Draft_Open}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="sectionLabel" IsVisible="{Binding HasInstalledPacks}"
                     Text="{DynamicResource Text.Studio_Installed_Heading}" />

          <ItemsControl ItemsSource="{Binding InstalledPacks}" IsVisible="{Binding HasInstalledPacks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:StudioPackChoiceViewModel">
                <Border Classes="card" Margin="0,0,0,12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                      <panels:GameIconView DataContext="{Binding Icon}" />
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource XxsmTextBrush}" />
                      <Border Classes="badge" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayVersion}" />
                      </Border>
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                            Command="{Binding $parent[ItemsControl].((pages:StudioPageViewModel)DataContext).OpenPackCommand}"
                            CommandParameter="{Binding}"
                            Content="{DynamicResource Text.Studio_Installed_Open}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>

      <!-- ===== An open draft: the table, and the Problems panel beside it ===== -->
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsDraftOpen}">

        <!-- The whole width when the Problems panel is over it rather than beside it. -->
        <DockPanel Grid.Column="0" Margin="0,0,16,16"
                   Classes="studioTable" Classes.problemsOver="{Binding IsProblemsOver}">

          <!-- Adding a character at one end, the table's controls at the other; each on its own line when narrow. -->
          <controls:SplitRow DockPanel.Dock="Top" Gap="12" LineSpacing="8" Margin="0,0,0,10">

          <!-- As wide as its placeholder whatever is typed; on its own line when narrow. -->
          <Grid ColumnDefinitions="Auto,Auto,Auto">
            <controls:PlaceholderWidthTextBox Grid.Column="0" Margin="0,0,8,0"
                     Text="{Binding NewCharacterName}"
                     PlaceholderText="{DynamicResource Text.Studio_Add_Placeholder}"
                     AutomationProperties.Name="{DynamicResource Text.Studio_Add_Placeholder}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddCharacterCommand}" />
              </TextBox.KeyBindings>
            </controls:PlaceholderWidthTextBox>
            <Button Grid.Column="1" Command="{Binding AddCharacterCommand}"
                    Content="{DynamicResource Text.Studio_Add}" />
            <!-- Ticked, adds just the name; unticked, opens the Character Manager on it. -->
            <CheckBox Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding IsFastAdd}"
                      Content="{DynamicResource Text.Studio_FastAdd}"
                      ToolTip.Tip="{DynamicResource Text.Studio_FastAdd_Tip}" />
          </Grid>

          <WrapPanel Classes="buttonRow" VerticalAlignment="Center" Margin="0,0,-8,-6">
            <!-- Back to the table's own widths, each column fitted to what it holds. -->
            <Button VerticalAlignment="Center"
                    Command="{Binding ResetColumnWidthsCommand}"
                    Content="{DynamicResource Text.Studio_ResetColumns}"
                    ToolTip.Tip="{DynamicResource Text.Studio_ResetColumns_Tip}" />
            <!-- Picking several characters, as a character's mods are picked; the tooltip names the keyboard way. -->
            <ToggleButton Classes="chip" VerticalAlignment="Center"
                          IsChecked="{Binding IsSelectMode}"
                          Content="{DynamicResource Text.CharacterDetail_Select}"
                          ToolTip.Tip="{DynamicResource Text.CharacterDetail_Selection_Hint}" />

            <!-- The folded Problems panel: an arrow and its count. The margin keeps the row's height. -->
            <Panel IsVisible="{Binding IsProblemsArrowInRow}" VerticalAlignment="Center" Margin="4,-6,8,0"
                   Classes="problemsArrow" Classes.covered="{Binding IsProblemsOver}">
              <Button Classes="iconButton" Command="{Binding ToggleProblemsCommand}"
                      ToolTip.Tip="{DynamicResource Text.Studio_Problems_Expand}"
                      AutomationProperties.Name="{DynamicResource Text.Studio_Problems_Expand}">
                <Path Data="{StaticResource Icon.chevronLeft}" />
              </Button>
              <Border Classes="countBubble" Classes.error="{Binding IsProblemBadgeError}"
                      IsVisible="{Binding HasProblemBadge}" IsHitTestVisible="False"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0">
                <TextBlock Text="{Binding ProblemBadgeText}" />
              </Border>
            </Panel>
          </WrapPanel>

          </controls:SplitRow>

          <!-- The bulk actions for several characters. Under the table, so opening it never moves a row. -->
          <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,10,0,0" IsVisible="{Binding IsSelectionBarVisible}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="subheading" VerticalAlignment="Center" Text="{Binding SelectionText}" />
                <Button Grid.Column="1"
                        IsVisible="{Binding IsSelectMode}"
                        Command="{Binding EndSelectModeCommand}"
                        Content="{DynamicResource Text.CharacterDetail_Selection_Done}" />
              </Grid>

              <!-- The same rows every time: with no attributes, that row is greyed. -->
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                    IsEnabled="{Binding HasSelection}">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,8"
                           Text="{DynamicResource Text.Studio_Bulk_Base}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                  <ComboBox Width="200" ItemsSource="{Binding BaseChoices}" SelectedItem="{Binding BulkBase}"
                            AutomationProperties.Name="{DynamicResource Text.Studio_Bulk_Base}" />
                  <Button Command="{Binding LinkSelectedCommand}"
                          Content="{DynamicResource Text.Studio_Bulk_Link}" />
                  <Button Command="{Binding UnlinkSelectedCommand}"
                          Content="{DynamicResource Text.Studio_Bulk_Unlink}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,8"
                           Text="{DynamicResource Text.Studio_Bulk_Attribute}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                  <!-- By name, as the table's headers say it; the id is what gets written. -->
                  <ComboBox Width="200" ItemsSource="{Binding AttributeChoices}" SelectedItem="{Binding BulkAttribute}"
                            IsEnabled="{Binding HasAttributeChoices}"
                            PlaceholderText="{Binding AttributePlaceholder}"
                            AutomationProperties.Name="{DynamicResource Text.Studio_Bulk_Attribute}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:StudioAttributeColumn">
                        <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <!-- The attribute's own values to pick from, and room to type another; a number is typed. -->
                  <ComboBox x:Name="BulkValueChooser" Width="240" IsEditable="True"
                            IsVisible="{Binding HasBulkValueChoices}"
                            ItemsSource="{Binding BulkValueChoices}"
                            Text="{Binding BulkAttributeValue, Mode=TwoWay}"
                            PlaceholderText="{DynamicResource Text.Studio_Bulk_Value}"
                            AutomationProperties.Name="{DynamicResource Text.Studio_Bulk_Value}" />
                  <TextBox Width="240" Text="{Binding BulkAttributeValue}"
                           IsVisible="{Binding !HasBulkValueChoices}"
                           IsEnabled="{Binding HasAttributeChoices}"
                           PlaceholderText="{DynamicResource Text.Studio_Bulk_Value}"
                           AutomationProperties.Name="{DynamicResource Text.Studio_Bulk_Value}" />
                  <Button Command="{Binding SetAttributeCommand}"
                          IsEnabled="{Binding HasAttributeChoices}"
                          Content="{DynamicResource Text.Studio_Bulk_SetAttribute}" />
                  <Button Command="{Binding ClearAttributeCommand}"
                          IsEnabled="{Binding HasAttributeChoices}"
                          Content="{DynamicResource Text.Studio_Bulk_ClearAttribute}" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,8"
                           Text="{DynamicResource Text.Studio_Bulk_Alias}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                  <TextBox Width="200" Text="{Binding AliasPrefix}"
                           PlaceholderText="{DynamicResource Text.Studio_Bulk_Prefix}"
                           AutomationProperties.Name="{DynamicResource Text.Studio_Bulk_Prefix}" />
                  <TextBox Width="200" Text="{Binding AliasSuffix}"
                           PlaceholderText="{DynamicResource Text.Studio_Bulk_Suffix}"
                           AutomationProperties.Name="{DynamicResource Text.Studio_Bulk_Suffix}" />
                  <Button Command="{Binding AddAliasCommand}"
                          Content="{DynamicResource Text.Studio_Bulk_AddAlias}" />
                </StackPanel>

                <!-- Delete on its own line, apart from the edits above it. -->
                <Button Classes="destructive" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                        Command="{Binding DeleteSelectedCommand}"
                        Foreground="{DynamicResource XxsmErrorBrush}"
                        Content="{DynamicResource Text.Studio_Bulk_Delete}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Where a column's cells are measured when its edge is double-clicked (DataGridColumnSizer). -->
          <Canvas x:Name="MeasureHost" DockPanel.Dock="Bottom" Width="0" Height="0"
                  ClipToBounds="True" IsHitTestVisible="False" Opacity="0" />

          <!-- Every cell edits in place, read back once in OnCellEditEnding; attribute columns from code. -->
          <DataGrid x:Name="CharacterGrid"
                    ItemsSource="{Binding Rows}"
                    SelectionMode="Extended"
                    GridLinesVisibility="Horizontal"
                    IsReadOnly="False"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="True"
                    CanUserResizeColumns="True"
                    SelectionChanged="OnRowsSelectionChanged"
                    PreparingCellForEdit="OnPreparingCellForEdit"
                    CellEditEnding="OnCellEditEnding">
            <!-- Right-click selects the row under the pointer first (StudioPage.axaml.cs). -->
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{DynamicResource Text.Studio_Row_Edit}"
                          Command="{Binding #Page.((pages:StudioPageViewModel)DataContext).EditSelectedCommand}" />
                <!-- Deletes what is selected; Undo brings it back. -->
                <MenuItem Classes="destructive" Header="{DynamicResource Text.Studio_Bulk_Delete}"
                          Command="{Binding #Page.((pages:StudioPageViewModel)DataContext).DeleteSelectedCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <!-- The tick boxes, while Select is on: a read-out of the selection, changed by the press on the row. -->
              <DataGridTemplateColumn Tag="tick" Width="40" MinWidth="40" CanUserResize="False" CanUserSort="False"
                                      IsReadOnly="True" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <Panel Background="Transparent">
                      <CheckBox Margin="8,0,0,0" VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                IsChecked="{Binding IsTicked, Mode=OneWay}"
                                AutomationProperties.Name="{DynamicResource Text.CharacterDetail_Select_Column}" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- One character's full editor, the Character Manager. -->
              <DataGridTemplateColumn Width="40" MinWidth="40" CanUserResize="False" CanUserSort="False" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <Button Classes="iconButton" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding $parent[DataGrid].((pages:StudioPageViewModel)DataContext).EditCharacterCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{DynamicResource Text.Studio_Row_Edit}"
                            AutomationProperties.Name="{DynamicResource Text.Studio_Row_Edit}">
                      <Path Data="{StaticResource Icon.edit}" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- The picture or its initial. Double-click or F2 chooses a file; hover shows it larger. -->
              <DataGridTemplateColumn Header="{DynamicResource Text.Studio_Column_Picture}" Tag="picture"
                                      SortMemberPath="HasPortrait" Width="88" MinWidth="88" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <Border Classes="studioPicture" ToolTip.Tip="{DynamicResource Text.Studio_Picture_Tip}"
                            AutomationProperties.Name="{DynamicResource Text.Studio_Column_Picture}">
                      <Panel>
                        <TextBlock Classes="studioPictureInitial" Text="{Binding Initials}"
                                   IsVisible="{Binding Picture.HasBitmap, Converter={x:Static BoolConverters.Not}, FallbackValue=True}" />
                        <Image Source="{Binding Picture.Bitmap}" Stretch="UniformToFill"
                               IsVisible="{Binding Picture.HasBitmap}">
                          <ToolTip.Tip>
                            <StackPanel Spacing="6">
                              <Image Source="{Binding Picture.Bitmap}" Width="128" Stretch="Uniform" />
                              <TextBlock FontSize="11" Text="{DynamicResource Text.Studio_Picture_Tip}" />
                            </StackPanel>
                          </ToolTip.Tip>
                        </Image>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <Border Classes="studioPicture">
                      <TextBlock Classes="studioPictureInitial" Text="{Binding Initials}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{DynamicResource Text.Studio_Column_Name}" Tag="name"
                                      SortMemberPath="DisplayName" Width="180" MinWidth="60">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <TextBlock Classes="cell" Text="{Binding DisplayName}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <TextBox Classes="cell" Text="{Binding DisplayName, Mode=OneWay}"
                             AutomationProperties.Name="{DynamicResource Text.Studio_Column_Name}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{DynamicResource Text.Studio_Column_Id}" Tag="internalName"
                                      SortMemberPath="InternalName" Width="180" MinWidth="60">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <TextBlock Classes="cell" Text="{Binding InternalName}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <TextBox Classes="cell" Text="{Binding InternalName, Mode=OneWay}"
                             AutomationProperties.Name="{DynamicResource Text.Studio_Column_Id}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{DynamicResource Text.Studio_Column_Base}" Tag="outfitOf"
                                      SortMemberPath="OutfitOf" Width="130" MinWidth="60">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <TextBlock Classes="cell" Text="{Binding OutfitOf}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <AutoCompleteBox Classes="cell"
                                     Text="{Binding OutfitOf, Mode=OneWay}"
                                     ItemsSource="{Binding $parent[DataGrid].((pages:StudioPageViewModel)DataContext).OutfitChoices}"
                                     PlaceholderText="{DynamicResource Text.Studio_Cell_OutfitOf_Placeholder}"
                                     AutomationProperties.Name="{DynamicResource Text.Studio_Column_Base}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{DynamicResource Text.Studio_Column_Aliases}" Tag="aliases"
                                      SortMemberPath="AliasesText" Width="130" MinWidth="60">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <TextBlock Classes="cell" Text="{Binding AliasesText}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <TextBox Classes="cell" Text="{Binding AliasesText, Mode=OneWay}"
                             AutomationProperties.Name="{DynamicResource Text.Studio_Column_Aliases}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <!-- The spare width before the state columns; the page sets it, one pixel at least. -->
              <DataGridTemplateColumn Tag="spacer" Header="" Width="1" MinWidth="1"
                                      CanUserResize="False" CanUserSort="False" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <Panel />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{DynamicResource Text.Studio_Column_Hashes}" Tag="hashes"
                                      SortMemberPath="HashCount" Width="90" MinWidth="60">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <TextBlock Classes="cell" Text="{Binding HashCountText}"
                               ToolTip.Tip="{Binding HashesText}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <!-- Editing this cell opens the hashes panel instead (OnPreparingCellForEdit). -->
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <TextBlock Classes="cell" Text="{Binding HashCountText}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <!-- Pressing the cell narrows the Problems panel to that character, opening it if folded. -->
              <DataGridTemplateColumn Header="{DynamicResource Text.Studio_Column_Problems}" Tag="problems" Width="100" MinWidth="60" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StudioCharacterRowViewModel">
                    <Button Classes="cellLink" IsVisible="{Binding HasProblems}"
                            Command="{Binding $parent[DataGrid].((pages:StudioPageViewModel)DataContext).ShowProblemsForCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{DynamicResource Text.Studio_Problem_ShowTip}"
                            AutomationProperties.Name="{DynamicResource Text.Studio_Problem_ShowTip}">
                      <Panel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource XxsmErrorBrush}"
                                   IsVisible="{Binding HasErrors}"
                                   Text="{DynamicResource Text.Studio_Problem_Error}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource XxsmWarnBrush}"
                                   IsVisible="{Binding HasOnlyWarnings}"
                                   Text="{DynamicResource Text.Studio_Problem_Warning}" />
                      </Panel>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

        </DockPanel>

        <!-- The Problems panel: live, each row going to its character; it folds away, and the choice is remembered. -->
        <!-- 320 wide while there is room, narrower when not (StudioPage.axaml.cs). -->
        <!-- A narrow page lays it over the table's right-hand side, lifted by a shadow. -->
        <Border x:Name="ProblemsPanel" Grid.Column="1" Classes="card problemsPanel" Margin="0,0,0,16" Width="320"
                Classes.over="{Binding IsProblemsOver}"
                IsVisible="{Binding !IsProblemsCollapsed}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="subheading" VerticalAlignment="Center"
                           Text="{DynamicResource Text.Studio_Problems_Heading}" />
                <Button Grid.Column="1" Classes="iconButton" Command="{Binding ToggleProblemsCommand}"
                        ToolTip.Tip="{DynamicResource Text.Studio_Problems_Collapse}"
                        AutomationProperties.Name="{DynamicResource Text.Studio_Problems_Collapse}">
                  <Path Data="{StaticResource Icon.chevronRight}" />
                </Button>
              </Grid>
              <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding ProblemsSummary}"
                         Foreground="{DynamicResource XxsmTextBrush}" />
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasProblems}"
                         Text="{DynamicResource Text.Studio_Problems_Blocking}" />

              <!-- One chip per kind of problem the draft has; none picked shows every kind. -->
              <ItemsControl ItemsSource="{Binding ProblemKinds}" IsVisible="{Binding HasProblemKinds}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StudioProblemKindViewModel">
                    <ToggleButton Classes="chip" Margin="0,0,6,6"
                                  Content="{Binding Text}"
                                  IsChecked="{Binding IsSelected}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsProblemFilterOn}">
                <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Text="{Binding ProblemFilterText}" />
                <Button Grid.Column="1" Command="{Binding ClearProblemFilterCommand}"
                        Content="{DynamicResource Text.Studio_Problems_ShowAll}" />
              </Grid>
            </StackPanel>

            <ScrollViewer>
              <!-- Clear of the scroll bar, which otherwise sits over the ends of the lines. -->
              <ItemsControl ItemsSource="{Binding VisibleProblems}" Margin="0,0,14,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StudioProblemViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource XxsmErrorBrush}"
                                   IsVisible="{Binding IsError}" Text="{DynamicResource Text.Studio_Problem_Error}" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource XxsmWarnBrush}"
                                   IsVisible="{Binding !IsError}" Text="{DynamicResource Text.Studio_Problem_Warning}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Message}"
                                   Foreground="{DynamicResource XxsmTextBrush}" />
                      </StackPanel>
                      <!-- Each problem's button does what fixes it, and says so. -->
                      <Button Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0"
                              IsVisible="{Binding HasAction}"
                              Command="{Binding $parent[ItemsControl].((pages:StudioPageViewModel)DataContext).ActOnProblemCommand}"
                              CommandParameter="{Binding}"
                              Content="{Binding ActionText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

      </Grid>

    </Panel>

  </DockPanel>

  <!-- ===== Game settings: the game's details and its attributes ===== -->
  <Border Classes="scrim" IsVisible="{Binding GameSettings.IsOpen}" />

  <Border Classes="card" Width="760" MaxHeight="780"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          IsVisible="{Binding IsOpen}"
          DataContext="{Binding GameSettings}" x:DataType="vm:StudioGameSettingsViewModel">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="subheading" Margin="0,0,0,12"
                 Text="{DynamicResource Text.Studio_Settings_Heading}" />

      <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,14,0,0">
        <TextBlock FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource XxsmErrorBrush}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding Error}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Command="{Binding CloseCommand}"
                  Content="{DynamicResource Text.Studio_Settings_Cancel}" />
          <Button Classes="accent" Command="{Binding SaveCommand}"
                  Content="{DynamicResource Text.Studio_Settings_Save}" />
        </StackPanel>
      </StackPanel>

      <ScrollViewer>
        <StackPanel Spacing="18" Margin="0,0,12,0">

          <!-- Details -->
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Settings_Details}" />
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Grid.Row="0" Classes="muted" VerticalAlignment="Center" Text="{DynamicResource Text.Studio_Settings_Name}" />
              <Border Grid.Row="0" Grid.Column="1" Classes="fixTarget" Classes.on="{Binding IsNameHighlighted}" Padding="0">
                <TextBox Text="{Binding Name}"
                         AutomationProperties.Name="{DynamicResource Text.Studio_Settings_Name}" />
              </Border>
              <TextBlock Grid.Row="1" Classes="muted" VerticalAlignment="Center" Text="{DynamicResource Text.Studio_Settings_ShortName}" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ShortName}"
                       AutomationProperties.Name="{DynamicResource Text.Studio_Settings_ShortName}" />
              <TextBlock Grid.Row="2" Classes="muted" VerticalAlignment="Center" Text="{DynamicResource Text.Studio_Settings_Importer}" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Importer}"
                       AutomationProperties.Name="{DynamicResource Text.Studio_Settings_Importer}" />
              <TextBlock Grid.Row="3" Classes="muted" VerticalAlignment="Center" Text="{DynamicResource Text.Studio_Settings_DisabledPrefix}" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DisabledPrefix}"
                       PlaceholderText="{DynamicResource Text.Studio_Settings_DisabledPrefix_Placeholder}"
                       AutomationProperties.Name="{DynamicResource Text.Studio_Settings_DisabledPrefix}" />
              <TextBlock Grid.Row="4" Classes="muted" VerticalAlignment="Center" Text="{DynamicResource Text.Studio_Settings_ModsFolder}" />
              <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource XxsmTextBrush}"
                           Text="{Binding ModsFolderText}" />
                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ChooseModsFolderCommand}"
                        Content="{DynamicResource Text.Studio_Settings_Choose}"
                        AutomationProperties.Name="{DynamicResource Text.Studio_Settings_ModsFolder}" />
              </Grid>
              <TextBlock Grid.Row="5" Classes="muted" VerticalAlignment="Center" Text="{DynamicResource Text.Studio_Settings_Icon}" />
              <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource XxsmTextBrush}" Text="{Binding IconText}" />
                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ChooseIconCommand}"
                        Content="{DynamicResource Text.Studio_Settings_Choose}"
                        AutomationProperties.Name="{DynamicResource Text.Studio_Settings_Icon}" />
                <Button Classes="destructive" Grid.Column="2" Margin="8,0,0,0" Command="{Binding RemoveIconCommand}"
                        Content="{DynamicResource Text.Studio_Settings_RemoveIcon}" />
              </Grid>
            </Grid>
          </StackPanel>

          <!-- Attributes -->
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Settings_Attributes}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{DynamicResource Text.Studio_Settings_Attributes_Help}" />
            <ItemsControl x:Name="AttributeList" ItemsSource="{Binding Attributes}"
                          PointerMoved="OnAttributeListPointerMoved"
                          PointerReleased="OnAttributeListPointerReleased"
                          PointerCaptureLost="OnAttributeListCaptureLost">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StudioAttributeEditorViewModel">
                  <!-- A fixed width, not Auto: each row is its own grid, and Auto would not line up across rows. -->
                  <!-- Outlined when a Problems button opened it; transparent otherwise, to line up. -->
                  <Border Classes="fixTarget" Classes.on="{Binding IsHighlighted}" Padding="2" Margin="0,0,0,6">
                  <Grid Classes="attributeRow" ColumnDefinitions="130,150,110,*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding Id}" IsReadOnly="{Binding !IsNew}"
                             PlaceholderText="{DynamicResource Text.Studio_Settings_AttributeId}"
                             AutomationProperties.Name="{DynamicResource Text.Studio_Settings_AttributeId}" />
                    <TextBox Grid.Column="1" Text="{Binding Label}"
                             PlaceholderText="{DynamicResource Text.Studio_Settings_AttributeLabel}"
                             AutomationProperties.Name="{DynamicResource Text.Studio_Settings_AttributeLabel}" />
                    <CheckBox Grid.Column="2" IsChecked="{Binding IsNumber}"
                              Content="{DynamicResource Text.Studio_Settings_AttributeNumber}" />
                    <TextBox Grid.Column="3" Text="{Binding ValuesText}" IsVisible="{Binding HasValues}"
                             PlaceholderText="{DynamicResource Text.Studio_Settings_AttributeValues}"
                             AutomationProperties.Name="{DynamicResource Text.Studio_Settings_AttributeValues}" />
                    <Button Classes="destructive" Grid.Column="4"
                            Command="{Binding $parent[ItemsControl].((vm:StudioGameSettingsViewModel)DataContext).RemoveAttributeCommand}"
                            CommandParameter="{Binding}"
                            Foreground="{DynamicResource XxsmErrorBrush}"
                            Content="{DynamicResource Text.Studio_Settings_Remove}" />
                    <!-- Drag up or down to reorder; Up and Down move it when focused. -->
                    <Border Grid.Column="5" Classes="dragHandle" Focusable="True"
                            ToolTip.Tip="{DynamicResource Text.Studio_Settings_DragToReorder}"
                            AutomationProperties.Name="{DynamicResource Text.Studio_Settings_DragToReorder}"
                            PointerPressed="OnAttributeHandlePressed"
                            KeyDown="OnAttributeHandleKeyDown">
                      <Path Data="{StaticResource Icon.grip}" />
                    </Border>
                  </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Command="{Binding AddAttributeCommand}"
                    Content="{DynamicResource Text.Studio_Settings_AddAttribute}" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>

  <!-- ===== One character in the Character Manager, writing to the draft ===== -->
  <Border Classes="scrim" IsVisible="{Binding CharacterManager.IsOpen}" />
  <panels:CharacterManagerView DataContext="{Binding CharacterManager}" />

  <!-- ===== A character's hashes, in the same editor the Character Manager opens ===== -->
  <panels:HashListEditorView DataContext="{Binding HashList}" />

  <!-- ===== Shared hashes, or who carries one hash ===== -->
  <Border Classes="scrim" IsVisible="{Binding IsSharingOpen}" />

  <Border Classes="card" Width="720" MaxHeight="760"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          IsVisible="{Binding IsSharingOpen}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
        <TextBlock Classes="subheading" TextWrapping="Wrap" Text="{Binding SharingTitle}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding SharingIntro}" />
      </StackPanel>

      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0">
        <Button Grid.Column="1"
                Command="{Binding IgnoreSharedCommand}"
                Content="{Binding SharingIgnoreText}" />
        <Button Grid.Column="2"
                Command="{Binding CloseSharingCommand}"
                Content="{DynamicResource Text.Studio_Sharing_Close}" />
      </Grid>

      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Classes="sectionLabel" Text="{DynamicResource Text.Studio_Sharing_Characters}" />
        <ScrollViewer Grid.Row="1" MaxHeight="220" Margin="0,4,0,12">
          <ItemsControl ItemsSource="{Binding SharingCharacters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StudioSharingCharacterViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,14,6">
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource XxsmTextBrush}" Text="{Binding DisplayName}" />
                  <TextBlock Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center"
                             Text="{Binding CarriesText}" />
                  <Button Grid.Column="2"
                          Command="{Binding #Page.((pages:StudioPageViewModel)DataContext).OpenSharedHashesOfCommand}"
                          CommandParameter="{Binding}"
                          Content="{DynamicResource Text.Studio_Sharing_OpenHashes}" />
                  <Button Grid.Column="3" Classes="accent"
                          Command="{Binding #Page.((pages:StudioPageViewModel)DataContext).KeepSharedOnCommand}"
                          CommandParameter="{Binding}"
                          Content="{DynamicResource Text.Studio_Sharing_Keep}"
                          ToolTip.Tip="{DynamicResource Text.Studio_Sharing_Keep_Tip}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Classes="sectionLabel" Text="{DynamicResource Text.Studio_Sharing_Hashes}" />
        <ScrollViewer Grid.Row="3" Margin="0,4,0,0">
          <ItemsControl ItemsSource="{Binding SharingHashes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StudioSharedHashRowViewModel">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,14,4">
                  <SelectableTextBlock Grid.Column="0" Classes="mono" Text="{Binding Hash}" />
                  <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="{Binding CarriersText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>

  <!-- ===== What ignoring these hashes would cost ===== -->
  <Border Classes="scrim" IsVisible="{Binding IsIgnoreCostOpen}" />

  <Border Classes="card" Width="560" MaxHeight="620"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          IsVisible="{Binding IsIgnoreCostOpen}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
        <TextBlock Classes="subheading" TextWrapping="Wrap" Text="{Binding IgnoreCostTitle}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{DynamicResource Text.Studio_IgnoreCost_Intro}" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                  HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Command="{Binding IgnoreAnywayCommand}"
                Content="{DynamicResource Text.Studio_IgnoreCost_Anyway}" />
        <Button Classes="accent"
                Command="{Binding CancelIgnoreCommand}"
                Content="{DynamicResource Text.Studio_IgnoreCost_Cancel}" />
      </StackPanel>

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding IgnoreCostLosses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock TextWrapping="Wrap" Margin="0,0,14,4"
                         Foreground="{DynamicResource XxsmTextBrush}" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>

  <!-- ===== Which outfit is the default ===== -->
  <Border Classes="scrim" IsVisible="{Binding IsDefaultChoiceOpen}" />

  <Border Classes="card" Width="480" MaxHeight="640"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          IsVisible="{Binding IsDefaultChoiceOpen}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
        <TextBlock Classes="subheading" TextWrapping="Wrap" Text="{Binding DefaultChoiceTitle}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{DynamicResource Text.Studio_Default_Intro}" />
      </StackPanel>
      <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0"
              Command="{Binding CloseDefaultChoiceCommand}"
              Content="{DynamicResource Text.Studio_Default_Cancel}" />
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding DefaultChoices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StudioDefaultChoiceViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,14,6">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource XxsmTextBrush}" Text="{Binding DisplayName}" />
                <Border Grid.Column="1" Classes="statusPill accent" VerticalAlignment="Center" IsVisible="{Binding IsDefault}">
                  <TextBlock Text="{DynamicResource Text.Studio_Default_Current}" />
                </Border>
                <Button Grid.Column="2"
                        Command="{Binding #Page.((pages:StudioPageViewModel)DataContext).MakeDefaultCommand}"
                        CommandParameter="{Binding}"
                        Content="{DynamicResource Text.Studio_Default_Make}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>

  <!-- ===== Hashes no character claims ===== -->
  <Border Classes="scrim" IsVisible="{Binding IsUnclaimedOpen}" />

  <Border Classes="card" MaxWidth="480"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          IsVisible="{Binding IsUnclaimedOpen}">
    <StackPanel Spacing="12">
      <TextBlock Classes="subheading" Text="{DynamicResource Text.Studio_Unclaimed_Title}" />
      <TextBlock TextWrapping="Wrap" Text="{Binding UnclaimedText}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Command="{Binding CloseUnclaimedCommand}"
                Content="{DynamicResource Text.Studio_Unclaimed_Cancel}" />
        <Button Classes="destructive" Command="{Binding DeleteUnclaimedCommand}"
                Content="{DynamicResource Text.Studio_Unclaimed_Delete}" />
        <Button Classes="accent"
                Command="{Binding ClaimUnclaimedCommand}"
                Content="{Binding UnclaimedCreateText}" />
      </StackPanel>
    </StackPanel>
  </Border>

  <!-- ===== Deleting a draft: the question, above the scrim ===== -->
  <Border Classes="scrim" IsVisible="{Binding IsDeleteDraftOpen}" />

  <Border Classes="card" MaxWidth="420"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          IsVisible="{Binding IsDeleteDraftOpen}">
    <StackPanel Spacing="14">
      <TextBlock TextWrapping="Wrap" Text="{Binding DeleteDraftQuestion}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Command="{Binding CancelDeleteDraftCommand}"
                Content="{DynamicResource Text.Studio_Delete_Cancel}" />
        <Button Classes="destructive"
                Command="{Binding ConfirmDeleteDraftCommand}"
                Content="{DynamicResource Text.Studio_Delete_Confirm}" />
      </StackPanel>
    </StackPanel>
  </Border>

  <!-- ===== Import: every importer's preview, nothing written until Add to draft ===== -->
  <Border Classes="scrim" IsVisible="{Binding Import.IsOpen}" />

  <Border Classes="card" IsVisible="{Binding IsOpen}"
          DataContext="{Binding Import}" x:DataType="vm:StudioImportViewModel"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          Width="900" MaxHeight="760">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
        <TextBlock Classes="subheading" Text="{Binding Heading}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Intro}" />

        <StackPanel Spacing="6" IsVisible="{Binding NeedsSource}">
          <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Import_Source}" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !HasSource}" Text="{DynamicResource Text.Studio_Wizard_NotChosen}" />
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding HasSource}" Text="{Binding Source}" />
            <Button Grid.Column="1" Margin="8,0,0,0" IsVisible="{Binding CanChooseArchive}"
                    Command="{Binding BrowseFileCommand}"
                    Content="{DynamicResource Text.Studio_Import_ChooseZip}" />
            <Button Grid.Column="2" Margin="8,0,0,0" IsVisible="{Binding SourceIsFolder}"
                    Command="{Binding BrowseFolderCommand}"
                    Content="{DynamicResource Text.Studio_Import_ChooseFolder}" />
            <Button Grid.Column="3" Margin="8,0,0,0" IsVisible="{Binding SourceIsFile}"
                    Command="{Binding BrowseFileCommand}"
                    Content="{DynamicResource Text.Studio_Import_ChooseFile}" />
            <Button Grid.Column="4" Margin="8,0,0,0" IsVisible="{Binding HasSource}"
                    Command="{Binding PlanCommand}"
                    Content="{DynamicResource Text.Studio_Import_Preview}" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding HasSheetColumns}">
          <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Import_Columns}" />
          <ItemsControl ItemsSource="{Binding SheetColumns}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StudioSheetColumnViewModel">
                <StackPanel Spacing="2" Margin="0,0,12,6">
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding Header}" />
                  <ComboBox MinWidth="150" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                            AutomationProperties.Name="{Binding Header}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:StudioSheetFieldOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HasRows}">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"
                     Foreground="{DynamicResource XxsmTextBrush}" Text="{Binding Summary}" />
          <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding SelectAllCommand}"
                  Content="{DynamicResource Text.Studio_Import_SelectAll}" />
          <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding SelectNoneCommand}"
                  Content="{DynamicResource Text.Studio_Import_SelectNone}" />
        </Grid>

        <TextBlock IsVisible="{Binding HasOutcome}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource XxsmTextBrush}" Text="{Binding Outcome}" />

        <ItemsControl IsVisible="{Binding HasMessages}" ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
        <Button Grid.Column="0" Command="{Binding CloseCommand}"
                Content="{DynamicResource Text.Studio_Close}" />
        <Button Grid.Column="2" Classes="accent" IsEnabled="{Binding CanApply}"
                Command="{Binding ApplyCommand}"
                Content="{DynamicResource Text.Studio_Import_Apply}" />
      </Grid>

      <ListBox ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StudioImportRowViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <CheckBox Grid.Column="0" VerticalAlignment="Top" IsChecked="{Binding Include}"
                        AutomationProperties.Name="{Binding Name}" />
              <StackPanel Grid.Column="1" Spacing="1" Margin="4,4,12,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource XxsmTextBrush}" Text="{Binding Name}" />
                  <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding Detail}" />
                </StackPanel>
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasNotes}" Text="{Binding Notes}" />
              </StackPanel>
              <CheckBox Grid.Column="2" VerticalAlignment="Top" IsVisible="{Binding HasLink}"
                        IsChecked="{Binding KeepLink}" Content="{Binding LinkText}" />
              <ComboBox Grid.Column="3" VerticalAlignment="Top" MinWidth="180" IsVisible="{Binding CanAssign}"
                        ItemsSource="{Binding Characters}" SelectedItem="{Binding AssignTo}"
                        AutomationProperties.Name="{DynamicResource Text.Studio_Import_Assign}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>

  <!-- ===== Try it: a dry run of a sort with this draft installed ===== -->
  <Border Classes="scrim" IsVisible="{Binding IsTryOpen}" />

  <Border Classes="card" IsVisible="{Binding IsTryOpen}"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          Width="760" MaxHeight="640">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
        <TextBlock Classes="subheading" Text="{DynamicResource Text.Studio_Try}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{DynamicResource Text.Studio_Try_Intro}" />
        <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Try_Folder}" />
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding !HasTryFolder}" Text="{DynamicResource Text.Studio_Wizard_NotChosen}" />
          <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding HasTryFolder}" Text="{Binding TryModsFolder, Converter={x:Static paths:PathConverters.Display}}" />
          <Button Grid.Column="1" Margin="8,0,0,0"
                  Command="{Binding BrowseTryModsCommand}"
                  Content="{DynamicResource Text.Studio_Wizard_Browse}"
                  AutomationProperties.Name="{DynamicResource Text.Studio_Try_Folder}" />
          <Button Grid.Column="2" Margin="8,0,0,0" Classes="accent"
                  IsEnabled="{Binding HasTryFolder}"
                  Command="{Binding RunTryCommand}"
                  Content="{DynamicResource Text.Studio_Try}" />
        </Grid>
        <TextBlock IsVisible="{Binding HasTryResult}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource XxsmTextBrush}" Text="{Binding TrySummary}" />
        <CheckBox IsVisible="{Binding HasTryResult}" IsChecked="{Binding TryShowEveryMod}"
                  Content="{DynamicResource Text.Studio_Try_ShowAll}" />
      </StackPanel>

      <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0"
              Command="{Binding CloseTryCommand}"
              Content="{DynamicResource Text.Studio_Close}" />

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding TryRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StudioTryRowViewModel">
              <StackPanel Spacing="2" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource XxsmTextBrush}"
                             Text="{Binding FolderName}" />
                  <TextBlock Classes="muted" FontSize="13" Text="→" />
                  <TextBlock FontSize="13" Foreground="{DynamicResource XxsmAccentBrush}" Text="{Binding Destination}" />
                </StackPanel>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Reason}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>

  <!-- ===== Export ===== -->
  <Border Classes="scrim" IsVisible="{Binding IsExportOpen}" />

  <Border Classes="card" IsVisible="{Binding IsExportOpen}"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          Width="620">
    <ScrollViewer MaxHeight="700">
      <StackPanel Spacing="8">
        <TextBlock Classes="subheading" Text="{DynamicResource Text.Studio_Export_Heading}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{DynamicResource Text.Studio_Export_Intro}" />
        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource XxsmErrorBrush}"
                   IsVisible="{Binding !CanExport}" Text="{DynamicResource Text.Studio_Export_Blocked}" />

        <TextBlock Classes="sectionLabel" Margin="0,6,0,0" Text="{DynamicResource Text.Studio_Export_Folder}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding !HasExportFolder}" Text="{DynamicResource Text.Studio_Wizard_NotChosen}" />
          <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding HasExportFolder}" Text="{Binding ExportFolder, Converter={x:Static paths:PathConverters.Display}}" />
          <Button Grid.Column="1" Margin="8,0,0,0"
                  Command="{Binding BrowseExportFolderCommand}"
                  Content="{DynamicResource Text.Studio_Wizard_Browse}"
                  AutomationProperties.Name="{DynamicResource Text.Studio_Export_Folder}" />
        </Grid>

        <TextBlock Classes="sectionLabel" Margin="0,6,0,0" Text="{DynamicResource Text.Studio_Export_Version}" />
        <TextBox Text="{Binding ExportVersion}" AutomationProperties.Name="{DynamicResource Text.Studio_Export_Version}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{DynamicResource Text.Studio_Export_Version_Hint}" />
        <CheckBox IsChecked="{Binding ExportOverwrite}" Content="{DynamicResource Text.Studio_Export_Overwrite}" />

        <TextBlock Classes="sectionLabel" Margin="0,6,0,0" Text="{DynamicResource Text.Studio_Export_Registry}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding !HasExportRegistryFolder}" Text="{DynamicResource Text.Studio_Wizard_NotChosen}" />
          <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding HasExportRegistryFolder}" Text="{Binding ExportRegistryFolder, Converter={x:Static paths:PathConverters.Display}}" />
          <Button Grid.Column="1" Margin="8,0,0,0"
                  Command="{Binding BrowseExportRegistryCommand}"
                  Content="{DynamicResource Text.Studio_Wizard_Browse}"
                  AutomationProperties.Name="{DynamicResource Text.Studio_Export_Registry}" />
        </Grid>

        <TextBox IsVisible="{Binding HasExportRegistryFolder}" Text="{Binding ExportChangelog}"
                 PlaceholderText="{DynamicResource Text.Studio_Export_Changelog}"
                 AutomationProperties.Name="{DynamicResource Text.Studio_Export_Changelog}" />

        <TextBlock Classes="sectionLabel" Margin="0,6,0,0" Text="{DynamicResource Text.Studio_Export_Contribution}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding !HasExportContributionFolder}" Text="{DynamicResource Text.Studio_Wizard_NotChosen}" />
          <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding HasExportContributionFolder}" Text="{Binding ExportContributionFolder, Converter={x:Static paths:PathConverters.Display}}" />
          <Button Grid.Column="1" Margin="8,0,0,0"
                  Command="{Binding BrowseExportContributionCommand}"
                  Content="{DynamicResource Text.Studio_Wizard_Browse}"
                  AutomationProperties.Name="{DynamicResource Text.Studio_Export_Contribution}" />
        </Grid>

        <Border Classes="inlineNotice" Margin="0,8,0,0" IsVisible="{Binding HasExportOutcome}">
          <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource XxsmTextBrush}"
                       Text="{Binding ExportOutcome.Summary, FallbackValue=''}" />
            <SelectableTextBlock Classes="mono" FontSize="11" TextWrapping="Wrap"
                                 Text="{Binding ExportOutcome.PackFile, FallbackValue=''}" />
            <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Export_Sha}" />
            <SelectableTextBlock Classes="mono" FontSize="11" TextWrapping="Wrap"
                                 Text="{Binding ExportOutcome.Sha256, FallbackValue=''}" />
            <StackPanel Spacing="2" IsVisible="{Binding ExportOutcome.HasIndex, FallbackValue=False}">
              <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Export_Index}" />
              <SelectableTextBlock Classes="mono" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding ExportOutcome.IndexPath, FallbackValue='', Converter={x:Static paths:PathConverters.Display}}" />
            </StackPanel>
            <StackPanel Spacing="2" IsVisible="{Binding ExportOutcome.HasContribution, FallbackValue=False}">
              <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Export_ContributionDone}" />
              <SelectableTextBlock Classes="mono" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding ExportOutcome.ContributionDirectory, FallbackValue='', Converter={x:Static paths:PathConverters.Display}}" />
            </StackPanel>
            <Button HorizontalAlignment="Left" Margin="0,4,0,0"
                    Command="{Binding OpenExportFolderCommand}"
                    Content="{DynamicResource Text.Studio_Export_OpenFolder}" />
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
          <Button Grid.Column="0"
                  Command="{Binding CloseExportCommand}"
                  Content="{DynamicResource Text.Studio_Close}" />
          <Button Grid.Column="2" Classes="accent"
                  IsEnabled="{Binding CanRunExport}"
                  Command="{Binding ExportCommand}"
                  Content="{DynamicResource Text.Studio_Export}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Border>

  <!-- ===== The new-game wizard: a few short steps, only the name required ===== -->
  <Border Classes="scrim" IsVisible="{Binding IsNewGameOpen}" />

  <Border Classes="card" IsVisible="{Binding IsNewGameOpen}"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          Width="520" MaxWidth="520">
    <StackPanel Spacing="14">
      <StackPanel Spacing="2">
        <TextBlock Classes="subheading" Text="{DynamicResource Text.Studio_Wizard_Heading}" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding WizardStepText}" />
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsWizardStep1}">
        <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Wizard_Name}" />
        <TextBox Text="{Binding NewGameName}"
                 AutomationProperties.Name="{DynamicResource Text.Studio_Wizard_Name}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{DynamicResource Text.Studio_Wizard_Name_Hint}" />
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsWizardStep2}">
        <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Wizard_ShortName}" />
        <TextBox Text="{Binding NewGameShortName}"
                 AutomationProperties.Name="{DynamicResource Text.Studio_Wizard_ShortName}" />
        <TextBlock Classes="sectionLabel" Margin="0,8,0,0" Text="{DynamicResource Text.Studio_Wizard_Importer}" />
        <TextBox Text="{Binding NewGameImporter}"
                 AutomationProperties.Name="{DynamicResource Text.Studio_Wizard_Importer}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{DynamicResource Text.Studio_Wizard_Importer_Hint}" />
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsWizardStep3}">
        <TextBlock Classes="sectionLabel" Text="{DynamicResource Text.Studio_Wizard_Icon}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding !HasNewGameIcon}" Text="{DynamicResource Text.Studio_Wizard_NotChosen}" />
          <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding HasNewGameIcon}" Text="{Binding NewGameIcon}" />
          <Button Grid.Column="1" Margin="8,0,0,0"
                  Command="{Binding BrowseNewGameIconCommand}"
                  Content="{DynamicResource Text.Studio_Wizard_Browse}"
                  AutomationProperties.Name="{DynamicResource Text.Studio_Wizard_Icon}" />
        </Grid>

        <TextBlock Classes="sectionLabel" Margin="0,8,0,0" Text="{DynamicResource Text.Studio_Wizard_Mods}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding !HasNewGameModsFolder}" Text="{DynamicResource Text.Studio_Wizard_NotChosen}" />
          <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding HasNewGameModsFolder}" Text="{Binding NewGameModsFolder, Converter={x:Static paths:PathConverters.Display}}" />
          <Button Grid.Column="1" Margin="8,0,0,0"
                  Command="{Binding BrowseNewGameModsCommand}"
                  Content="{DynamicResource Text.Studio_Wizard_Browse}"
                  AutomationProperties.Name="{DynamicResource Text.Studio_Wizard_Mods}" />
        </Grid>
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{DynamicResource Text.Studio_Wizard_Mods_Hint}" />
      </StackPanel>

      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button Grid.Column="0"
                Command="{Binding CancelNewGameCommand}"
                Content="{DynamicResource Text.Studio_Wizard_Cancel}" />
        <Button Grid.Column="2" Margin="0,0,8,0"
                IsVisible="{Binding CanWizardBack}"
                Command="{Binding WizardBackCommand}"
                Content="{DynamicResource Text.Studio_Wizard_Back}" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
          <Button IsVisible="{Binding CanWizardNext}"
                  Command="{Binding WizardNextCommand}"
                  Content="{DynamicResource Text.Studio_Wizard_Next}" />
          <Button Classes="accent"
                  IsEnabled="{Binding CanCreateGame}"
                  Command="{Binding CreateGameCommand}"
                  Content="{DynamicResource Text.Studio_Wizard_Create}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>

  <!-- ===== After Install in XXSM: the same panels as an install from the Packs page ===== -->
  <Border Classes="scrim" IsVisible="{Binding FollowUp.IsAnyPanelOpen}" />
  <panels:WhatsNewView DataContext="{Binding FollowUp.WhatsNew}" />
  <panels:SkippedUpdatesView DataContext="{Binding FollowUp.SkippedUpdates}" />
  <panels:CaughtUpCorrectionsView DataContext="{Binding FollowUp.CaughtUp}" />

  </Panel>

</UserControl>
